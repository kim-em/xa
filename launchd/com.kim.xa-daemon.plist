<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kim.xa-daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec /Users/kim/projects/xa/.venv/bin/xa-daemon</string>
    </array>

    <key>UserName</key>
    <string>kim</string>
    <key>GroupName</key>
    <string>staff</string>
    <key>WorkingDirectory</key>
    <string>/Users/kim</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- ~/.local/bin because that is where `claude` lives, and a monitor in
             `investigate` or `auto` mode launches it. A launchd job inherits no
             login shell, so a missing entry here is stored as the plan. -->
        <key>PATH</key>
        <string>/Users/kim/bin:/Users/kim/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/kim</string>
        <key>USER</key>
        <string>kim</string>
        <key>LOGNAME</key>
        <string>kim</string>
        <key>XA_POLICY</key>
        <string>/Users/kim/metacortex/xa</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/kim/.local/state/xa/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kim/.local/state/xa/daemon.log</string>
</dict>
</plist>
